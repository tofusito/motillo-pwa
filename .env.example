# Copy to .env, set real values, and protect it (chmod 600). Never commit .env.
# Meross account credentials are passed only to the meross-connector service.
MEROSS_EMAIL=you@example.invalid
MEROSS_PASSWORD=replace-with-your-meross-password
MEROSS_REGION=eu
MEROSS_MFA_CODE=
# Fill these after listing your devices with the discovery command in README.md.
MEROSS_DEVICE_ID=
# Private LAN IPv4 address of the selected device; required to run the connector.
MEROSS_HOST=
# Generate a separate, long random token for the internal connector API.
CONNECTOR_TOKEN=replace-with-a-long-random-token
# Exact browser origin. Leave local until HTTPS and authentication are configured.
APP_ORIGIN=http://127.0.0.1:3060
# Whether the daily energy counter is expected to reset at midnight in Europe/Madrid.
DAILY_ENERGY_RESET=true
